<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contour Flow main dialog layout (Qt Designer file).
  Layout only. All behaviour (filters, visibility, validation, running) lives in contour_dialog.py.
  Loaded at runtime with qgis.PyQt.uic.loadUiType; no generated Python file is committed.
  QGIS widgets are declared as custom widgets with header "qgis.gui".
  Widget objectNames are used from Python: keep them in sync when editing in Qt Designer.
-->
<ui version="4.0">
 <class>ContourDialogBase</class>
 <widget class="QDialog" name="ContourDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>760</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Contour Flow</string>
  </property>
  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="text">
      <string>Create editable contour lines from points with a numeric field, or from a raster.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QgsMessageBar" name="message_bar"/>
   </item>
   <item>
    <widget class="QScrollArea" name="scroll_area">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <property name="frameShape">
      <enum>QFrame::NoFrame</enum>
     </property>
     <widget class="QWidget" name="scroll_contents">
      <layout class="QVBoxLayout" name="scroll_layout">
       <item>
        <widget class="QGroupBox" name="input_group">
         <property name="title">
          <string>Input</string>
         </property>
         <layout class="QVBoxLayout" name="input_layout">
          <item>
           <layout class="QFormLayout" name="source_form">
            <item row="0" column="0">
             <widget class="QLabel" name="mode_caption">
              <property name="text">
               <string>Mode:</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QComboBox" name="mode_combo">
              <property name="toolTip">
               <string>General: contour any numeric field or raster. Groundwater: monitoring wells to groundwater-elevation contours with groundwater QA checks and optional flow-direction arrows.</string>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="source_caption">
              <property name="text">
               <string>Source:</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QWidget" name="source_widget">
              <layout class="QHBoxLayout" name="source_layout">
               <property name="leftMargin">
                <number>0</number>
               </property>
               <property name="topMargin">
                <number>0</number>
               </property>
               <property name="rightMargin">
                <number>0</number>
               </property>
               <property name="bottomMargin">
                <number>0</number>
               </property>
               <item>
                <widget class="QRadioButton" name="point_mode_radio">
                 <property name="text">
                  <string>Point layer</string>
                 </property>
                 <property name="checked">
                  <bool>true</bool>
                 </property>
                 <property name="toolTip">
                  <string>Interpolate a numeric field of a point layer, then contour the surface.</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QRadioButton" name="raster_mode_radio">
                 <property name="text">
                  <string>Raster</string>
                 </property>
                 <property name="toolTip">
                  <string>Contour an existing elevation raster (DEM).</string>
                 </property>
                </widget>
               </item>
               <item>
                <spacer name="source_spacer">
                 <property name="orientation">
                  <enum>Qt::Horizontal</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>40</width>
                   <height>20</height>
                  </size>
                 </property>
                </spacer>
               </item>
              </layout>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QWidget" name="point_input_widget">
            <layout class="QFormLayout" name="point_input_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="point_layer_caption">
               <property name="text">
                <string>Point layer:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QgsMapLayerComboBox" name="point_layer_combo"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="value_field_caption">
               <property name="text">
                <string>Value / elevation field:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QgsFieldComboBox" name="value_field_combo">
               <property name="toolTip">
                <string>Numeric field to contour, e.g. groundwater or ground elevation.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="feature_mode_caption">
               <property name="text">
                <string>Features:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QComboBox" name="feature_mode_combo"/>
             </item>
             <item row="3" column="0" colspan="2">
              <widget class="QLabel" name="selection_count_label">
               <property name="text">
                <string notr="true"/>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QWidget" name="gw_input_widget">
            <layout class="QFormLayout" name="gw_input_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="gw_method_caption">
               <property name="text">
                <string>Groundwater elevation:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="gw_method_combo">
               <property name="toolTip">
                <string>Use a field that already holds groundwater elevations (heads), or calculate them as measuring-point elevation minus depth to water. The layer is never changed.</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="gw_head_caption">
               <property name="text">
                <string>Elevation field:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QComboBox" name="gw_head_combo">
               <property name="toolTip">
                <string>Numeric fields, and text fields whose values are mostly numbers. Text such as 'Dry' or 'N/A' is skipped and reported, never treated as 0.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="gw_mp_caption">
               <property name="text">
                <string>Measuring-point elevation:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QComboBox" name="gw_mp_combo">
               <property name="toolTip">
                <string>Elevation of the measuring point (e.g. top of casing), same datum and units as the result.</string>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="gw_dtw_caption">
               <property name="text">
                <string>Depth to water:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QComboBox" name="gw_dtw_combo">
               <property name="toolTip">
                <string>Depth to water below the measuring point (positive downwards).</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0" colspan="2">
              <widget class="QLabel" name="gw_count_label">
               <property name="text">
                <string notr="true"/>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QWidget" name="raster_input_widget">
            <layout class="QFormLayout" name="raster_input_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="raster_layer_caption">
               <property name="text">
                <string>Raster layer:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QgsMapLayerComboBox" name="raster_layer_combo"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="raster_band_caption">
               <property name="text">
                <string>Band:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QgsRasterBandComboBox" name="raster_band_combo"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="boundary_group">
         <property name="title">
          <string>Boundary (optional)</string>
         </property>
         <layout class="QFormLayout" name="boundary_layout">
          <item row="0" column="0">
           <widget class="QLabel" name="boundary_layer_caption">
            <property name="text">
             <string>Clip to polygon:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QgsMapLayerComboBox" name="boundary_layer_combo">
            <property name="toolTip">
             <string>Contours are clipped exactly to this polygon layer. Any CRS.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="contour_group">
         <property name="title">
          <string>Contours</string>
         </property>
         <layout class="QFormLayout" name="contour_layout">
          <item row="0" column="0">
           <widget class="QLabel" name="interval_mode_caption">
            <property name="text">
             <string>Interval:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="interval_mode_combo">
            <property name="toolTip">
             <string>Automatic picks a clean interval (1, 2, 2.5 or 5 x 10^n) from the data range and the approximate count.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="target_count_caption">
            <property name="text">
             <string>Approximate count:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="target_count_spin">
            <property name="minimum">
             <number>2</number>
            </property>
            <property name="maximum">
             <number>200</number>
            </property>
            <property name="value">
             <number>10</number>
            </property>
            <property name="toolTip">
             <string>Roughly how many contour levels the automatic interval should give.</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="fixed_interval_caption">
            <property name="text">
             <string>Fixed interval:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="fixed_interval_spin">
            <property name="decimals">
             <number>4</number>
            </property>
            <property name="minimum">
             <double>0.0001</double>
            </property>
            <property name="maximum">
             <double>1000000000.0</double>
            </property>
            <property name="value">
             <double>1.0</double>
            </property>
            <property name="toolTip">
             <string>Contours are drawn at multiples of this value, in the units of the field or raster.</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_mode_caption">
            <property name="text">
             <string>Labels:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QComboBox" name="label_mode_combo"/>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="style_caption">
            <property name="text">
             <string>Style:</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QComboBox" name="style_combo">
            <property name="toolTip">
             <string>Colour preset. Minor lines thin, major lines thick.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="gw_group">
         <property name="title">
          <string>Groundwater</string>
         </property>
         <layout class="QFormLayout" name="gw_layout">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="flow_arrows_check">
            <property name="text">
             <string>Generate flow arrows</string>
            </property>
            <property name="toolTip">
             <string>Adds a 'GW Flow Direction' line layer: arrows in the direction of decreasing groundwater elevation, derived from the interpolated surface. Drawn only where wells support the surface.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="output_group">
         <property name="title">
          <string>Output</string>
         </property>
         <layout class="QFormLayout" name="output_layout">
          <item row="0" column="0">
           <widget class="QLabel" name="output_mode_caption">
            <property name="text">
             <string>Save as:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="output_mode_combo">
            <property name="toolTip">
             <string>Temporary layers are lost when QGIS closes unless saved. GeoPackage output never overwrites existing layers.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="geopackage_caption">
            <property name="text">
             <string>GeoPackage:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QgsFileWidget" name="geopackage_file_widget"/>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="output_name_caption">
            <property name="text">
             <string>Layer name:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="output_name_edit">
            <property name="placeholderText">
             <string>Automatic</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QgsCollapsibleGroupBox" name="advanced_group">
         <property name="title">
          <string>Advanced settings</string>
         </property>
         <layout class="QVBoxLayout" name="advanced_layout">
          <item>
           <widget class="QGroupBox" name="advanced_interpolation_group">
            <property name="title">
             <string>Interpolation (point input)</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_interpolation_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="method_caption">
               <property name="text">
                <string>Method:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="method_combo"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="idw_power_caption">
               <property name="text">
                <string>IDW power:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="idw_power_spin">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>0.1</double>
               </property>
               <property name="maximum">
                <double>99.99</double>
               </property>
               <property name="value">
                <double>2.0</double>
               </property>
               <property name="toolTip">
                <string>Higher values give nearby points more influence. 2 is the usual choice.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0" colspan="2">
              <widget class="QCheckBox" name="cell_size_auto_check">
               <property name="text">
                <string>Automatic cell size</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
               <property name="toolTip">
                <string>About 500 cells along the longer side of the extent.</string>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="cell_size_caption">
               <property name="text">
                <string>Cell size:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QDoubleSpinBox" name="cell_size_spin">
               <property name="decimals">
                <number>6</number>
               </property>
               <property name="minimum">
                <double>1e-06</double>
               </property>
               <property name="maximum">
                <double>1000000000.0</double>
               </property>
               <property name="value">
                <double>1.0</double>
               </property>
               <property name="toolTip">
                <string>Smaller cells give more detail but take longer and make larger files. In the point layer's CRS units.</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_extent_group">
            <property name="title">
             <string>Extent (point input)</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_extent_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="extent_mode_caption">
               <property name="text">
                <string>Interpolate over:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="extent_mode_combo">
               <property name="toolTip">
                <string>Where the surface is computed. Values outside the measured points are less certain.</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="buffer_caption">
               <property name="text">
                <string>Hull buffer:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="buffer_spin">
               <property name="decimals">
                <number>4</number>
               </property>
               <property name="minimum">
                <double>0.0</double>
               </property>
               <property name="maximum">
                <double>1000000000.0</double>
               </property>
               <property name="value">
                <double>10.0</double>
               </property>
               <property name="toolTip">
                <string>Distance around the convex hull, in the point layer's CRS units.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="custom_extent_caption">
               <property name="text">
                <string>Custom extent:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QgsExtentWidget" name="custom_extent_widget"/>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_points_group">
            <property name="title">
             <string>Duplicate locations (point input)</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_points_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="duplicate_mode_caption">
               <property name="text">
                <string>Several points at one location:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="duplicate_mode_combo">
               <property name="toolTip">
                <string>Different values at the same location may be different wells, screens or intervals.</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_boundary_group">
            <property name="title">
             <string>Boundary</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_boundary_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="boundary_mode_caption">
               <property name="text">
                <string>Boundary features:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="boundary_mode_combo"/>
             </item>
             <item row="1" column="0" colspan="2">
              <widget class="QLabel" name="boundary_count_label">
               <property name="text">
                <string notr="true"/>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_contours_group">
            <property name="title">
             <string>Contour lines</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_contours_layout">
             <item row="0" column="0" colspan="2">
              <widget class="QCheckBox" name="major_auto_check">
               <property name="text">
                <string>Automatic major contours</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
               <property name="toolTip">
                <string>Major contours on round numbers: every 1, 10, 100... units (or 5 for interval 1).</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="major_every_caption">
               <property name="text">
                <string>Major contour every:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QSpinBox" name="major_every_spin">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>1000</number>
               </property>
               <property name="value">
                <number>5</number>
               </property>
               <property name="toolTip">
                <string>Every Nth level is a major contour (field is_major = 1), drawn thicker.</string>
               </property>
               <property name="suffix">
                <string> intervals</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="label_decimals_caption">
               <property name="text">
                <string>Label decimals:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QSpinBox" name="label_decimals_spin">
               <property name="minimum">
                <number>0</number>
               </property>
               <property name="maximum">
                <number>6</number>
               </property>
               <property name="value">
                <number>2</number>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="smoothing_caption">
               <property name="text">
                <string>Smoothing:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QComboBox" name="smoothing_combo">
               <property name="toolTip">
                <string>Rounds contour corners. Changes line geometry only, never the source values or the surface.</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="smooth_iterations_caption">
               <property name="text">
                <string>Iterations:</string>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QSpinBox" name="smooth_iterations_spin">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>5</number>
               </property>
               <property name="value">
                <number>1</number>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="smooth_offset_caption">
               <property name="text">
                <string>Offset:</string>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QDoubleSpinBox" name="smooth_offset_spin">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>0.05</double>
               </property>
               <property name="maximum">
                <double>0.5</double>
               </property>
               <property name="value">
                <double>0.25</double>
               </property>
               <property name="toolTip">
                <string>How much each corner is cut (0.05-0.5).</string>
               </property>
              </widget>
             </item>
             <item row="6" column="0" colspan="2">
              <widget class="QCheckBox" name="keep_unsmoothed_check">
               <property name="text">
                <string>Also keep an unsmoothed copy</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_gw_group">
            <property name="title">
             <string>Groundwater: QA and flow arrows</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_gw_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="gw_ground_caption">
               <property name="text">
                <string>Ground elevation (QA only):</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="gw_ground_combo">
               <property name="toolTip">
                <string>Optional. Used only to flag groundwater elevations above ground; never used in the interpolation.</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="arrow_count_caption">
               <property name="text">
                <string>Approximate arrows:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QSpinBox" name="arrow_count_spin">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>500</number>
               </property>
               <property name="value">
                <number>9</number>
               </property>
               <property name="toolTip">
                <string>Roughly how many arrows over the arrow area. Few arrows keep the map readable.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="arrow_scaling_caption">
               <property name="text">
                <string>Arrow length:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QComboBox" name="arrow_scaling_combo">
               <property name="toolTip">
                <string>Uniform: all arrows the same length. Scaled: longer where the hydraulic gradient is steeper (50-100 % of the arrow size).</string>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="arrow_length_caption">
               <property name="text">
                <string>Arrow size:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QDoubleSpinBox" name="arrow_length_spin">
               <property name="decimals">
                <number>2</number>
               </property>
               <property name="minimum">
                <double>0.0</double>
               </property>
               <property name="maximum">
                <double>1000000000.0</double>
               </property>
               <property name="value">
                <double>0.0</double>
               </property>
               <property name="toolTip">
                <string>Arrow length in map units. Automatic: 60 % of the arrow spacing.</string>
               </property>
               <property name="specialValueText">
                <string>Automatic</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="arrow_support_caption">
               <property name="text">
                <string>Draw arrows:</string>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QComboBox" name="arrow_support_combo">
               <property name="toolTip">
                <string>Where arrows may be drawn. The well network (convex hull) is the most defensible area.</string>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="arrow_buffer_caption">
               <property name="text">
                <string>Arrow hull buffer:</string>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QDoubleSpinBox" name="arrow_buffer_spin">
               <property name="decimals">
                <number>4</number>
               </property>
               <property name="minimum">
                <double>0.0</double>
               </property>
               <property name="maximum">
                <double>1000000000.0</double>
               </property>
               <property name="value">
                <double>10.0</double>
               </property>
               <property name="toolTip">
                <string>Distance around the well network, in the point layer's CRS units.</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="advanced_surface_group">
            <property name="title">
             <string>Interpolated surface (point input)</string>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
            <layout class="QFormLayout" name="advanced_surface_layout">
             <item row="0" column="0">
              <widget class="QLabel" name="surface_mode_caption">
               <property name="text">
                <string>Surface raster:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="surface_mode_combo"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="surface_file_caption">
               <property name="text">
                <string>GeoTIFF:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QgsFileWidget" name="surface_file_widget"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="summary_group">
         <property name="title">
          <string>Summary</string>
         </property>
         <layout class="QVBoxLayout" name="summary_layout">
          <item>
           <widget class="QLabel" name="summary_label">
            <property name="text">
             <string notr="true">-</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="textFormat">
             <enum>Qt::RichText</enum>
            </property>
            <property name="textInteractionFlags">
             <set>Qt::TextSelectableByMouse</set>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="summary_button_layout">
            <item>
             <spacer name="summary_spacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="refresh_summary_button">
              <property name="text">
               <string>Refresh summary</string>
              </property>
              <property name="autoDefault">
               <bool>false</bool>
              </property>
              <property name="toolTip">
               <string>Recalculate the summary (needed for very large inputs).</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="scroll_spacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>10</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="generate_layout">
     <item>
      <widget class="QLabel" name="validation_label">
       <property name="text">
        <string notr="true">-</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="generate_button">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="text">
        <string>Generate Contours</string>
       </property>
       <property name="autoDefault">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="diagnostics_layout">
     <item>
      <widget class="QLabel" name="qgis_version_caption">
       <property name="text">
        <string>QGIS:</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="qgis_version_value">
       <property name="text">
        <string notr="true">-</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="plugin_version_caption">
       <property name="text">
        <string>Contour Flow:</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="plugin_version_value">
       <property name="text">
        <string notr="true">-</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="status_caption">
       <property name="text">
        <string>Build:</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="status_value">
       <property name="text">
        <string notr="true">-</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="diagnostics_spacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="button_box">
     <property name="standardButtons">
      <set>QDialogButtonBox::Close</set>
     </property>
    </widget>
   </item>
  </layout>
