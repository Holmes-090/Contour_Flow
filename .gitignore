# Python
__pycache__/
*.py[cod]

# Virtual environments / tooling caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated Qt files (the .ui file is loaded at runtime instead)
ui_*.py
resources_rc.py

# Plugin packaging output
*.zip
build/
dist/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# QGIS side files from local test data
*.qgs~
*.qgz~
*.aux.xml

# Real-QGIS integration test output (fixtures and results, regenerated each run)
tests/integration_output/

# SQLite / GeoPackage side files left by QGIS or GDAL
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal
*.sqlite-journal

# Processing / GDAL temporary outputs that may land in the repo
processing_*/
*.tmp
