    <height>820</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Contour Generator</string>
  </property>
  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="text">
      <string>Generate editable contour lines from point elevations or raster surfaces.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
