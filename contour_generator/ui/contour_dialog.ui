            <property name="maximum">
             <number>200</number>
            </property>
            <property name="value">
             <number>10</number>
            </property>
            <property name="toolTip">
             <string>The interval is chosen from 1, 2, 2.5 or 5 x 10^n to give about this many contour levels.</string>
