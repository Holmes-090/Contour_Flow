     <widget class="QWidget" name="scroll_contents">
      <layout class="QVBoxLayout" name="scroll_layout">
       <item>
        <widget class="QGroupBox" name="input_group">
         <property name="title">
          <string>Input</string>
         </property>
         <layout class="QVBoxLayout" name="input_layout">
